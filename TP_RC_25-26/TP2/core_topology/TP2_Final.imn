node n1 {
    type router
    model router
    network-config {
	hostname RA1
	!
	interface eth1
	 ip address 10.0.1.1/24
	 ipv6 address 2001:1::1/64
	!
	interface eth0
	 ip address 10.0.0.1/24
	 ipv6 address 2001:0::1/64
	!
    }
    canvas c1
    iconcoords {329.0 244.0}
    labelcoords {329.0 276.0}
    interface-peer {eth0 n3}
    interface-peer {eth1 n2}
}

node n2 {
    type router
    model router
    network-config {
	hostname RA2
	!
	interface eth1
	 ip address 10.0.2.1/24
	 ipv6 address 2001:2::1/64
	!
	interface eth0
	 ip address 10.0.1.2/24
	 ipv6 address 2001:1::2/64
	!
    }
    canvas c1
    iconcoords {561.0 246.0}
    labelcoords {561.0 278.0}
    interface-peer {eth0 n1}
    interface-peer {eth1 n4}
}

node n3 {
    type lanswitch
    network-config {
	hostname SW1
	!
    }
    canvas c1
    iconcoords {161.0 242.0}
    labelcoords {161.0 266.0}
    interface-peer {e0 n5}
    interface-peer {e1 n6}
    interface-peer {e2 n1}
}

node n4 {
    type lanswitch
    network-config {
	hostname SW2
	!
    }
    canvas c1
    iconcoords {721.0 250.0}
    labelcoords {721.0 274.0}
    interface-peer {e0 n2}
    interface-peer {e1 n7}
    interface-peer {e3 n9}
}

